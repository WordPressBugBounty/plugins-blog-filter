{
  "devDependencies": {
    "autoprefixer": "^10.4.20",
    "postcss": "^8.5.3",
    "tailwindcss": "^4.0.8",
    "tailwindcss-cli": "^0.1.2"
  },
  "scripts": {
  "start": "npm run watch",
  "build": "npx tailwindcss-cli -i ./css/styles.css -o ./css/styles.min.css --minify",
